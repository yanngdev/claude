{
  "printWidth": 120,
  "tabWidth": 2,
  "semi": true,
  "singleQuote": true,
  "jsxSingleQuote": false,
  "trailingComma": "all",
  "sortImports": { "newlinesBetween": false, "internalPattern": ["@/"] },
  "sortTailwindcss": {
    "stylesheet": "./src/index.css",
    "functions": ["cn", "cva", "tv"]
  },
  "overrides": [{ "files": ["**/*.yml", "**/*.yaml"], "options": { "singleQuote": false } }],
  "ignorePatterns": [
    "dist",
    "dev-dist",
    "coverage",
    "package-lock.json",
    ".config/**",
    ".claude/rules/shared/**",
    ".claude/skills/shared-*/**",
    ".claude/hooks/format-and-lint.mjs"
  ]
}
