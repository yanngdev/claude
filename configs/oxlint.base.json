{
  "$schema": "../node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "jsx-a11y", "import", "unicorn", "oxc", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "env": {
    "browser": true,
    "es2024": true
  },
  "rules": {
    "curly": ["error", "all"],
    "eqeqeq": "error",
    "no-var": "error",
    "prefer-const": "error",
    "no-console": "warn",
    "typescript/no-explicit-any": "error",
    "typescript/consistent-type-imports": "error",
    "import/no-default-export": "error",
    "import/no-unassigned-import": [
      "warn",
      { "allow": ["**/*.css", "@testing-library/jest-dom/**", "@fontsource*/**"] }
    ],
    // Custom ARIA widgets (combobox, segmented radios, swipeable rows) have no native element with the
    // same behavior; preferring a semantic element stays a review rule (see the shared React rules).
    "jsx-a11y/prefer-tag-over-role": "off",
    // A mock is type-checked where it is passed; typing every vi.fn() adds noise without catching more.
    "vitest/require-mock-type-parameters": "off",
    // Worker.postMessage takes no target origin; the rule cannot tell a worker from a window.
    "unicorn/require-post-message-target-origin": "off",
    "react/react-in-jsx-scope": "off",
    "react/jsx-key": "error",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react/no-multi-comp": "error",
    "react/static-components": "error",
    "react/immutability": "error",
    "react/globals": "error",
    "react/refs": "error",
    "react/purity": "error",
    "react/set-state-in-effect": "error",
    "react/set-state-in-render": "error",
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "react",
            "importNames": [
              "useState",
              "useEffect",
              "useLayoutEffect",
              "useMemo",
              "useRef",
              "useCallback",
              "useSyncExternalStore",
              "useReducer",
              "useContext",
              "useId",
              "useTransition",
              "useDeferredValue",
              "use"
            ],
            "message": "Use the React object: import React from 'react', then React.useMemo, React.useEffect, ..."
          }
        ],
        "patterns": [
          {
            "regex": "^\\.\\./",
            "message": "Use the @/ alias instead of parent-relative imports."
          }
        ]
      }
    ]
  },
  "ignorePatterns": ["dist", "dev-dist", "coverage", "node_modules", ".wrangler"],
  "overrides": [
    {
      "files": ["**/*.config.ts", "**/*.config.mts", "worker/**"],
      "rules": {
        "import/no-default-export": "off"
      }
    },
    {
      "files": ["scripts/**", "worker/**", "pipeline/**"],
      "rules": {
        "no-console": "off"
      }
    }
  ]
}
